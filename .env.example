PORT=3000
MOMO_PARTNER_CODE=MOM***
MOMO_ACCESS_KEY=your-access-key
MOMO_SECRET_KEY=your-secret-key
# Base URL only; the SDK appends /v2/gateway/api/create, /query, ...
MOMO_ENDPOINT=https://test-payment.momo.vn # hoặc https://payment.momo.vn/v2/gateway/api nếu chạy trên môi trường production

# localhost.run dùng SSH reverse tunnel, không cần tài khoản hoặc authtoken.
# Dùng URL public cố định nếu bạn có sẵn; nếu bỏ trống, localhost.run sẽ tạo URL HTTPS.
APP_BASE_URL=
TUNNEL_ENABLED=true
MOMO_DEBUG=true
